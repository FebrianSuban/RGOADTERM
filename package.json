{
  "name": "rgoadterm",
  "version": "1.0.0",
  "description": "RGOADTERM - Windows Terminal",
  "main": "main.js",
  "author": "Febrian Suban",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win nsis"
  },
  "dependencies": {
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.3.0"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.febriansuban.rgoadterm",
    "productName": "RGOADTERM",

    "directories": {
      "output": "dist"
    },

    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "renderer/**/*",
      "node_modules/**/*"
    ],

    "asarUnpack": [
      "node_modules/@lydell/node-pty/**/*"
    ],

    "win": {
      "icon": "build/logo.ico",
      "target": "nsis",
      "artifactName": "RGOADTERM-${version}-Setup.exe"
    },

    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "RGOADTERM"
    }
  }
}